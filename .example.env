# SOCPilot AI — Environment Variables
# Copy this file to .env and fill in your values.
# The system gracefully degrades if API keys are missing.

# ── LLM Provider: Groq ──────────────────────────────────────────────────────
# Get your free key at: https://console.groq.com
GROQ_API_KEY=enter key

# Groq model to use. Recommended options:
#   llama-3.3-70b-versatile  (best quality, default)
#   llama-3.1-8b-instant     (fastest, lower latency)
#   mixtral-8x7b-32768       (good for long context)
GROQ_MODEL=llama-3.3-70b-versatile

# ── Threat Intelligence APIs ────────────────────────────────────────────────
# AbuseIPDB — IP reputation lookup
# Get free key at: https://www.abuseipdb.com/api
ABUSEIPDB_API_KEY=enter key

# VirusTotal — File hash reputation lookup
# Get free key at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=enter key

# NVD NIST — CVE lookup (optional, works without key at lower rate limit)
# Get free key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=enter key

# ── Storage Configuration ────────────────────────────────────────────────────
# Directory where ChromaDB will persist its data
CHROMA_PERSIST_DIR=./chroma_db

# HuggingFace embedding model (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Report Output ────────────────────────────────────────────────────────────
# Directory where generated reports will be saved
REPORTS_DIR=./reports

# ── Logging ──────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── SIEM Integration Server ───────────────────────────────────────────────────
# Host and port for the webhook server (run with: uvicorn siem_server:app)
SIEM_SERVER_HOST=0.0.0.0
SIEM_SERVER_PORT=8000

# Minimum Wazuh alert level (1-15) to trigger an investigation.
# Alerts below this level are silently dropped (no investigation started).
# Recommended thresholds:
#   5  = medium+ (default)
#   8  = high+
#   12 = critical only
WAZUH_MIN_ALERT_LEVEL=5

# Optional Bearer token to secure the /webhook/* endpoints.
# When set, Wazuh (or any SIEM) must send:
#   Authorization: Bearer <your-token>
# Leave empty to disable authentication (not recommended for production).
WAZUH_WEBHOOK_TOKEN=enter secuirty token
